{
  "name": "apparel-designer",
  "productName": "Apparel Designer",
  "version": "2.3.0",
  "description": "Warp, dither and CMYK halftone screening for garment artwork. Vector in, vector out.",
  "main": "electron/main.js",
  "author": "Aditya Sharma",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "web": "python3 serve.py",
    "test": "node test/halftone.test.js && node test/engine.test.js && node test/geom.test.js && node test/raster.test.js && node test/registry.test.js && node test/update.test.js && node test/update-network.test.js",
    "suite": "electron . --suite --dpr=2",
    "bench": "electron . --bench --dpr=2",
    "dist": "electron-builder --mac --config electron-builder.yml --publish never",
    "release": "node scripts/release.js",
    "shots": "electron . --shots --dpr=2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "onnxruntime-node": "^1.20.1"
  },
  "homepage": "https://github.com/aditya31Sharma/apparel-designer",
  "repository": {
    "type": "git",
    "url": "https://github.com/aditya31Sharma/apparel-designer.git"
  },
  "bugs": {
    "url": "https://github.com/aditya31Sharma/apparel-designer/issues"
  }
}
